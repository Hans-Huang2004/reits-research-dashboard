//获取基金类型分类树
function getFundTypeTree() {
    ajaxJsonp($api.fundFilterType, "get", '', function (res) {
        var list = fundTypeListToTree(res.result);
        if (list.length > 0) {
            fundTypeTree = list[0].children;
            var node = {
                CATEGORY_CODE: "F000",
                CATEGORY_PARENT_CODE: "F000",
                CATEGORY_NAME: "不限",
                text: "不限"
            };
            fundTypeTree.push(node);
            // fundTypeTree.sort((a, b)=> a.CATEGORY_CODE.localeCompare(b.CATEGORY_CODE, 'en'));//排序
            fundTypeTree.sort(function (a, b) {
                return a.CATEGORY_CODE.localeCompare(b.CATEGORY_CODE, 'en')
            }); //排序
            //fundTypeTree = list;
        }
        //mobFundSelect();
    }, function (err) {
        console.log(err)
    });
}

//基金类型列表转树图
function fundTypeListToTree(oldArr) {
    oldArr.forEach(function (element) {
        var parentId = element.CATEGORY_PARENT_CODE;
        element.text = element.CATEGORY_NAME;
        if (parentId !== "-") {
            oldArr.forEach(function (ele) {
                if (ele.CATEGORY_CODE == parentId) { //当内层循环的ID== 外层循环的parendId时，（说明有children），需要往该内层id里建个children并push对应的数组；
                    if (!ele.children) {
                        ele.children = [];
                    }
                    ele.children.push(element); //此时的数组是在原基础上补充了children;
                }
            });
        }
    });
    oldArr = oldArr.filter(function (ele) {
        ele.CATEGORY_PARENT_CODE === "-"
    }); //这一步是过滤，按树展开，将多余的数组剔除；
    return oldArr;
}

