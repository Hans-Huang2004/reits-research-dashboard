/**
 *
 * @param flag
 * @param isSelectCategory 是否进页面第一次请求
 */
function getListData(flag, isSelectCategory) {
    //var CATEGORY = "F000";
    if (isSelectCategory) {
        if ($(".three-filter ul li.active").length > 0) {
            CATEGORY = $(".three-filter ul li.active").attr("code");
        } else if ($(".sub-filter div ul li.active").length > 0) {
            CATEGORY = $(".sub-filter div ul li.active").attr("code");
        } else if ($(".filter-parent > li.active").length > 0) {
            CATEGORY = $(".filter-parent > li.active").attr("code");
        }
    }
    var SUBCLASS;
    if ($("#SUBCLASS").prop("checked")) {
        SUBCLASS = $("#SUBCLASS").val();
    } else {
        SUBCLASS = "";
    }
    var SWING_TRADE = '';
    if ($("#SWING_TRADE").prop("checked")) {
        SWING_TRADE = $("#SWING_TRADE").val();
    }
    if (filterTemp == null) {
        listParams = {
            "pageHelp.cacheSize": 1,
            "pageHelp.pageSize": pageSize,
            "pageHelp.pageNo": pageNo,
            "pageHelp.beginPage": beginPage,
            "pageHelp.endPage": 1,
            "FUND_CODE": "",
            "COMPANY_NAME": "",
            "INDEX_NAME": "",
            "START_DATE": "",
            "END_DATE": "",
            "CATEGORY": CATEGORY,
            "CATEGORY_ASC": 1,
            "SUBCLASS": "",
            "SWING_TRADE": SWING_TRADE,
            "type": "inParams",
            "CATEGORY_ASC": 1
        };
        // 排序参数添加
        if (sortParams != null) {
            var sortArr = Object.keys(sortParams)
            for (var i = 0; i <= sortArr.length; i++) {
                if (sortParams[sortArr[i]] == 1) {
                    listParams[sortArr[i]] = 1
                }
            }
            delete listParams.CATEGORY_ASC;
        }
    } else {
        listParams = {
            "pageHelp.cacheSize": 1,
            "pageHelp.pageSize": pageSize,
            "pageHelp.pageNo": pageNo,
            "pageHelp.beginPage": beginPage,
            "pageHelp.endPage": 1,
            "FUND_CODE": filterTemp.FUND_CODE,
            "COMPANY_NAME": filterTemp.COMPANY_NAME,
            "INDEX_NAME": filterTemp.INDEX_NAME,
            "START_DATE": filterTemp.START_DATE ? filterTemp.START_DATE.replace(/-/g, "") : "",
            "END_DATE": filterTemp.END_DATE ? filterTemp.END_DATE.replace(/-/g, "") : "",
            "CATEGORY": CATEGORY,
            "SUBCLASS": filterTemp.SUBCLASS,
            "SWING_TRADE": SWING_TRADE,
            "type": "inParams"
        };
        if (CATEGORY == "F000") {
            listParams['CATEGORY_ASC'] = 1
        } else {
          if (sortParams != null) {
            var sortArr = Object.keys(sortParams)
            for (var i = 0; i <= sortArr.length; i++) {
                if (sortParams[sortArr[i]] == 1) {
                    listParams[sortArr[i]] = 1
                }
            }
            delete listParams.CATEGORY_ASC;
          } else {
            listParams["FUND_CODE_ASC"] = 1;
          }
        }
    }
    ajaxFundList(flag, listParams);
}

// 表格内容排序
function sort(obj) {
    var par = {
        "pageHelp.cacheSize": 1,
        "pageHelp.pageSize": pageSize,
        "pageHelp.pageNo": 1,
        "pageHelp.beginPage": 1,
        "pageHelp.endPage": 1,
        "FUND_CODE": listParams.FUND_CODE,
        "COMPANY_NAME": listParams.COMPANY_NAME,
        "INDEX_NAME": listParams.INDEX_NAME,
        "START_DATE": listParams.START_DATE,
        "END_DATE": listParams.END_DATE,
        "CATEGORY": listParams.CATEGORY,
        "SUBCLASS": listParams.SUBCLASS,
        "SWING_TRADE": listParams.SWING_TRADE,
        "type": "inParams"
    };
    sortParams = {
        "FUND_CODE_ASC": '',
        "INDEX_NAME_ASC": '',
        "LISTING_DATE_ASC": '',
        "SCALE_ASC": '',
        "COMPANY_NAME_ASC": '',
        "FUND_CODE_DESC": '',
        "INDEX_NAME_DESC": '',
        "LISTING_DATE_DESC": '',
        "SCALE_DESC": '',
        "COMPANY_NAME_DESC": '',
    }

    var type = $(obj).attr('sort')
    var asc = $(obj).attr('asc')
    if (asc == "true") {
        par[type + '_DESC'] = 1;
        sortParams[type + '_DESC'] = 1;
    } else {
        par[type + '_ASC'] = 1;
        sortParams[type + '_ASC'] = 1;
    }
    ajaxFundList('true', par)
    // 处理排序箭头展示
    setTimeout(function () {
        $('.fa-sort-asc').removeClass('fa-sort-asc')
        $('.fa-sort-desc').removeClass('fa-sort-desc')
        $('fa-fw').addClass('fa-sort')
        if (asc == "true") {
            $(obj).attr('asc', "false")
            $(obj).removeClass('fa-sort-asc')
            $(obj).addClass('fa-sort-desc')
        } else {
            $(obj).attr('asc', "true")
            $(obj).removeClass('fa-sort-desc')
            $(obj).addClass('fa-sort-asc')
        }
    })
}

// 基金列表 获取数据渲染
function ajaxFundList(flag, listParams) {
    ajaxJsonp($api.getFundList, "get", listParams, function (res) {
        $(".total-fund").html(res.pageHelp.total);
        var result = res.result;
        var html = "";
        var html2 = "";
        for (var i = 0; i < result.length; i++) {
            html += "<li class='fundlist-item' category='" + result[i].CATEGORY + "' code='" + result[i].FUND_CODE + "'>" +
                "<div>" + result[i].FUND_CODE + "</div>" +
                "<div>" + result[i].FUND_ABBR + "</div>" +
                "<div>" + result[i].FUND_EXPANSION_ABBR + "</div>" +
                "<div>" + result[i].INDEX_NAME + "</div>" +
                "<div>" + result[i].LISTING_DATE + "</div>" +
                "<div>" + result[i].SCALE + "</div>" +
                "<div>" + result[i].COMPANY_NAME + "</div>" +
                "</li>";
            html2 += "<tr code='" + result[i].FUND_CODE + "' class='fundlist-item' category='" + result[i].CATEGORY + "'><td>" + result[i].FUND_ABBR + "</td>" +
                "<td>" + result[i].FUND_CODE + "</td>" +
                "<td>" + result[i].FUND_EXPANSION_ABBR + "</td>" +
                "<td>" + result[i].INDEX_NAME + "</td>" +
                "<td>" + result[i].LISTING_DATE + "</td>" +
                "<td>" + result[i].SCALE + "</td>" +
                "<td>" + result[i].COMPANY_NAME + "</td></tr>";
        }
        $('.fundItem').html(html)
        $('.mob-trans-overv-tbody').html(html2)
        $(".fundlist-item").on("click", function () {
            var code = $(this).attr("code");
            var CATEGORY = $(this).attr("category");
            window.open("/fundlist/funddetail/index.shtml?code=" + code + "&category=" + CATEGORY, "_blank");
        });

        if (flag == undefined || flag) {
            $("#fundlist-pag .com-pagination").html('');
            $("#fundlist-pag-mob .com-pagination-mob").html('');
            pageCount = res.pageHelp.pageCount;
            if (pageCount > 1) {
                var pageHtml = '<li><a class="pagination-pre blur" href="javascript:;"><i class="fa fa-angle-left"></i></a></li>';
                var pageHtml2 = '<li style="display:inline-block"><a class="pagination-pre blur" href="javascript:;"><i class="fa fa-angle-left"></i></a></li>'; //移动端分页
                for (var j = 0; j < pageCount; j++) {
                    pageHtml += '<li>';
                    pageHtml2 += '<li style="display:inline-block">';
                    if (j == 0) {
                        pageHtml += '<a class="page active"';
                        pageHtml2 += '<a class="page active"';
                    } else {
                        pageHtml += '<a class="page"';
                        pageHtml2 += '<a class="page"';
                    }
                    if (j > 2 && j < pageCount - 1) {
                        pageHtml += ' style="display:none;"'
                        pageHtml2 += ' style="display:none;"'
                    }
                    pageHtml += ' "href="javascript:;">' + (j + 1) + '</a></li>';
                    pageHtml2 += ' "href="javascript:;">' + (j + 1) + '</a></li>';

                    if (pageCount >= 4 && j == 0) {
                        pageHtml += ' <li><a id="prePlaceHolder" "href="javascript:;">' + '...' + '</a></li>';
                        pageHtml2 += ' <li style="display:inline-block"><a id="prePlaceHolder-mob" "href="javascript:;">' + '...' + '</a></li>';
                    }
                    if (pageCount >= 4 && j == pageCount - 2) {
                        pageHtml += ' <li><a id="nextPlaceHolder" "href="javascript:;">' + '...' + '</a></li>';
                        pageHtml2 += ' <li style="display:inline-block"><a id="nextPlaceHolder-mob" "href="javascript:;">' + '...' + '</a></li>';
                    }
                }


                pageHtml += '<li><a class="pagination-next" href="javascript:;"><i class="fa fa-angle-right"></i></a></li>';
                pageHtml2 += '<li style="display:inline-block"><a class="pagination-next" href="javascript:;"><i class="fa fa-angle-right"></i></a></li>';
                $("#fundlist-pag .com-pagination").html(pageHtml);
                $("#fundlist-pag-mob .com-pagination-mob").html(pageHtml2);
                //$("#page-total").html(pageCount)
                bindTurnPage("#fundlist-pag", pageCount);
                bindTurnPage("#fundlist-pag-mob", pageCount);
                $("#prePlaceHolder").hide();
                $("#prePlaceHolder-mob").hide();
            }
        }
        if (result.length == 0) {
            $(".content-null-prompt").show()
            //$(".jump-page").hide()
        } else {
            $(".content-null-prompt").hide()
            //$(".jump-page").show()
        }
    }, function (err) {
        console.log(err)
    });
}
//获取移动端基金列表数据
function getMobListData(flag, isSelectCategory) {
    if (isSelectCategory) {
        if ($(".filter-sub-container li.active").length > 0) {
            mobCategory_code = $(".filter-sub-container li.active").attr("code");
        } else if ($(".filter-panel-sub > li.active").length > 0) {
            mobCategory_code = $(".filter-panel-sub li.active").attr("code");
        } else if ($(".filter-panel-parent > li.active").length > 0) {
            mobCategory_code = $(".filter-panel-parent > li.active").attr("code");
        }
    }

    if (mobFilterTemp == null) {
        listParams = {
            "pageHelp.cacheSize": 1,
            "pageHelp.pageSize": pageSize,
            "pageHelp.pageNo": pageNo,
            "pageHelp.beginPage": beginPage,
            "pageHelp.endPage": 1,
            "FUND_CODE": "",
            //"FUND_ABBR":FUND_ABBR,
            "COMPANY_NAME": "",
            "INDEX_NAME": "",
            "START_DATE": "",
            "END_DATE": "",
            "CATEGORY": mobCategory_code,
            "SUBCLASS": "",
            "SWING_TRADE": "",
            "type": "inParams"
        };
        if (sortParams != null) {
            var sortArr = Object.keys(sortParams)
            for (var i = 0; i <= sortArr.length; i++) {
                if (sortParams[sortArr[i]] == 1) {
                    listParams[sortArr[i]] = 1
                }
            }
            delete listParams.CATEGORY_ASC;
        }
    } else {
        listParams = {
            "pageHelp.cacheSize": 1,
            "pageHelp.pageSize": pageSize,
            "pageHelp.pageNo": pageNo,
            "pageHelp.beginPage": beginPage,
            "pageHelp.endPage": 1,
            "FUND_CODE": mobFilterTemp.FUND_CODE,
            //"FUND_ABBR":FUND_ABBR,
            "COMPANY_NAME": mobFilterTemp.COMPANY_NAME,
            "INDEX_NAME": mobFilterTemp.INDEX_NAME,
            "START_DATE": mobFilterTemp.START_DATE ? mobFilterTemp.START_DATE.replace(/-/g, "") : "",
            "END_DATE": mobFilterTemp.END_DATE ? mobFilterTemp.END_DATE.replace(/-/g, "") : "",
            "CATEGORY": mobCategory_code,
            "SUBCLASS": mobFilterTemp.SUBCLASS,
            "SWING_TRADE": mobFilterTemp.SWING_TRADE,
            "type": "inParams"
        };
        if (CATEGORY == "F000") {
            listParams['CATEGORY_ASC'] = 1
        }
        if (sortParams != null) {
            var sortArr = Object.keys(sortParams)
            for (var i = 0; i <= sortArr.length; i++) {
                if (sortParams[sortArr[i]] == 1) {
                    listParams[sortArr[i]] = 1
                }
            }
            delete listParams.CATEGORY_ASC;
        }
    }
    ajaxJsonp($api.getFundList, "get", listParams, function (res) {
        var result = res.result;
        $(".total-fund").html(res.pageHelp.total);

        var html2 = "";
        for (var i = 0; i < result.length; i++) {
            html2 += "<tr class='fundlist-item' category='" + result[i].CATEGORY + "' code='" + result[i].FUND_CODE + "'><td code='" + result[i].FUND_CODE + "'>" + result[i].FUND_ABBR + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].FUND_CODE + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].FUND_EXPANSION_ABBR + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].INDEX_NAME + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].LISTING_DATE + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].SCALE + "</td>" +
                "<td code='" + result[i].FUND_CODE + "'>" + result[i].COMPANY_NAME + "</td></tr>";
        }
        html2 += "</tbody>";
        $(".fundlist-mob tbody").html(html2);
        $(".fundlist-item").on("click", function () {
            var code = $(this).attr("code");
            var CATEGORY = $(this).attr("category");
            window.open("/fundlist/funddetail/index.shtml?code=" + code + "&category=" + CATEGORY, "_self");
        });
        if (flag == undefined || flag) {
            pageCount = res.pageHelp.pageCount;
            var pageHtml2 = '<li style="display:inline-block"><a class="pagination-pre blur" href="javascript:;"><i class="fa fa-angle-left"></i></a></li>'; //移动端分页
            for (var j = 0; j < pageCount; j++) {
                pageHtml2 += '<li style="display:inline-block">';
                if (j == 0) {
                    pageHtml2 += '<a class="page active"';
                } else {
                    pageHtml2 += '<a class="page"';
                }
                if (j > 2 && j < pageCount - 1) {
                    pageHtml2 += ' style="display:none;"'
                }
                pageHtml2 += ' "href="javascript:;">' + (j + 1) + '</a></li>';

                if (pageCount >= 4 && j == 0) {
                    pageHtml2 += ' <li style="display:inline-block"><a id="prePlaceHolder-mob" "href="javascript:;">' + '...' + '</a></li>';
                }
                if (pageCount >= 4 && j == pageCount - 2) {
                    pageHtml2 += ' <li style="display:inline-block"><a id="nextPlaceHolder-mob" "href="javascript:;">' + '...' + '</a></li>';
                }
            }
            pageHtml2 += '<li style="display:inline-block"><a class="pagination-next" href="javascript:;"><i class="fa fa-angle-right"></i></a></li>';
            $("#fundlist-pag-mob .com-pagination-mob").html(pageHtml2);
            bindTurnPage("#fundlist-pag-mob", pageCount);
            $("#prePlaceHolder-mob").hide();
            $('#fundlistModal').modal('hide');
        }
        //$("#page-total-mob").html(pageCount)
        if (result.length == 0) {
            $(".content-null-prompt").show()
            //$(".jump-page-mob").hide()
        } else {
            $(".content-null-prompt").hide()
            //$(".jump-page-mob").show()
        }
    }, function (err) {
        console.log(err)
    });
}

