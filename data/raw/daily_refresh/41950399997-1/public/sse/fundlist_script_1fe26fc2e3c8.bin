function getSearchListData() {
    var listnew = get_funddata();
    for (var i = 0; i < listnew.length; i++) {
        searchListData.push(listnew[i].val + "(" + listnew[i].val2 + ")");
    }
}

function getFundType(params, id, type, isFirst) {
    ajaxJsonp($api.fundFilterType, "get", params, function (res) {
        getSubNav(res.result, id, type, params, isFirst);
    }, function (err) {
        console.log(err)
    });
}

//移动端获取基金类型
function getMobFundType(params, id, type) {
    ajaxJsonp($api.fundFilterType, "get", params, function (res) {
        if (type == 1) {
            mobCategory = res.result;
        }
        getMobSubNav(res.result, id, type, params);
    }, function (err) {
        console.log(err)
    });
}

//移动端获取子菜单
function getMobSubNav(category, id, type, parentCode) {
    if (type == 1) { //一级
        var html = '<li code="F000" class="filter-panel-item fa-arrow all active">不限</li>';
        var htmlArr = [];
        var gmStr = "";
        for (var i = 0; i < category.length; i++) {
            //if(category[i].CATEGORY_CODE != "F300") {
            if (category[i].CATEGORY_CODE == "F600") {
                gmStr = "<li class='filter-panel-item fa-arrow' code='" + category[i].CATEGORY_CODE + "'>公募REITs</li>";
            } else {
                var filterStr = "<li class='filter-panel-item fa-arrow' code='" + category[i].CATEGORY_CODE + "'>" + category[i].CATEGORY_NAME + "</li>"
                //var filterStr = "<li class='filter-panel-item fa-arrow' code='" + category[i].CATEGORY_CODE + "'>" + category[i].CATEGORY_NAME + "</li>";
                htmlArr.push(filterStr)
            }
            //}
        }
        htmlArr.splice(2, 0, gmStr);
        for (var j = 0; j < htmlArr.length; j++) {
            html += htmlArr[j]
        }
        $(id).html(html);
        $(".filter-panel-parent > li").on("click", function (e) {
            e.stopPropagation();
            pageCount = 0;
            $(".filter-panel-parent > li").removeClass("active");
            $(this).addClass("active");
            var pCode = $(this).attr("code");
            mobCategory_code = pCode;
            if (pCode != "F000") {
                var params = {
                    CATEGORY_PARENT_CODE: pCode
                };
                getMobFundType(params, $(this), 2);
            } else {
                if ($(".filter-panel-sub").length > 0) {
                    $(".filter-panel-sub").remove();
                }
            }
        });
        // if (mobFirstLoad == true) {
        //     $("[code='F000']").click();
        // }
    } else if (type == 2) { //二级
        if (category.length > 0) {
            var html = "<ul class='filter-panel-container filter-panel-sub'>";
            for (var i = 0; i < category.length; i++) {
                //if(category[i].CATEGORY_CODE!="F290"){//二级栏目-“分级基金”“货币ETF”不展示
                html += "<li class='filter-panel-item fa-arrow' code='" + category[i].CATEGORY_CODE + "'";
                html += ">" + category[i].CATEGORY_NAME + "</li>";
                //}
            }
            html += "</ul>";
            if ($(".filter-panel-sub").length > 0) {
                $(".filter-panel-sub").remove();
            }
            $(id).append(html);
            $(".filter-panel-sub li").off("click").on("click", function (e) {
                pageCount = 0;
                e.stopPropagation();
                $(".filter-panel-sub li").removeClass("active");
                $(this).addClass("active");
                var pCode = $(this).attr("code");
                mobCategory_code = pCode;
                var params = {
                    CATEGORY_PARENT_CODE: pCode
                };
                getMobFundType(params, $(this), 3);
            });
        } else {
            if ($(".filter-panel-sub").length > 0) {
                $(".filter-panel-sub").remove();
            }
            $(".fdlist-filter").removeClass("pd-bottom-115");
            $(".fdlist-filter").removeClass("pd-bottom-55");
        }
    } else if (type == 3) { //三级
        if (category.length > 0) { //货币ETF没有子级
            var html = "<ul class='filter-sub-container'>";
            for (var i = 0; i < category.length; i++) {
                //if(category[i].CATEGORY_CODE!="F142"){//三级栏目-“期货ETF”不展示
                html += "<li class='filter-sub-item' code='" + category[i].CATEGORY_CODE + "'";
                html += ">" + category[i].CATEGORY_NAME + "</li>";
                //}
            }
            html += "</ul>";
            if ($(".filter-sub-container").length > 0) {
                $(".filter-sub-container").remove();
            }
            $(id).append(html);
            $(".filter-sub-container li").off("click").on("click", function (e) {
                pageCount = 0;
                e.stopPropagation();
                mobCategory_code = $(this).attr("code");
                $(".filter-sub-container li").removeClass("active");
                $(this).addClass("active");
            });
        } else {
            if ($(".filter-sub-container").length > 0) {
                $(".filter-sub-containerr").remove();
            }
        }
    }
    mobFirstLoad = false;
}

//获取子菜单
function getSubNav(category, id, type, parentCode, isFirst) {
    if (type == 1) { //第一级
        var html = "<li code='F000' class='active'>不限</li>";
        var htmlArr = [];
        var gmStr = "";
        for (var i = 0; i < category.length; i++) {
            //if(category[i].CATEGORY_CODE != "F300"){
            if (category[i].CATEGORY_CODE == "F600") {
                gmStr = "<li code='" + category[i].CATEGORY_CODE + "'>公募REITs</li>"
            } else {
                var filterStr = "<li code='" + category[i].CATEGORY_CODE + "'>" + category[i].CATEGORY_NAME + "</li>"
                htmlArr.push(filterStr)
            }
            //}
        }
        htmlArr.splice(2, 0, gmStr);
        for (var j = 0; j < htmlArr.length; j++) {
            html += htmlArr[j]
        }
        $(id).html(html);
        $(".filter-parent > li").off("click").on("click", function (event) {
            event.stopPropagation();
            pageCount = 0;
            $(".filter-parent > li").removeClass("active");
            $(this).addClass("active");
            $(".filter-parent > li").removeClass("border-bottom-none");
            var pCode = $(this).attr("code");
            if (pCode != "F000") {
                var params = {
                    CATEGORY_PARENT_CODE: pCode
                };
                getFundType(params, $(this), 2);
            } else {
                if ($(".sub-filter").length > 0) {
                    $(".fdlist-filter").removeClass("pd-bottom-115");
                    $(".fdlist-filter").removeClass("pd-bottom-55");
                    $(".sub-filter").remove();
                }
            }
        });
        // if (isFirst == true) {
        //     $("[code='F000']").click();
        // }
    } else if (type == 2) { //第二级
        if (category.length > 0) {
            var html = "<div class='sub-filter'><div><ul>";
            for (var i = 0; i < category.length; i++) {
                //if(category[i].CATEGORY_CODE!="F290"){//二级栏目-“分级基金”“货币ETF”不展示
                html += "<li code='" + category[i].CATEGORY_CODE + "'";
                html += ">" + category[i].CATEGORY_NAME + "</li>";
                //}
            }
            html += "</ul></div></div>";
            if ($(".sub-filter").length > 0) {
                $(".sub-filter").remove();
            }
            //$(".fdlist-filter").addClass("pd-bottom-115");
            $(".fdlist-filter").removeClass("pd-bottom-115");
            $(".fdlist-filter").addClass("pd-bottom-55");
            $(id).append(html);
            $(id).addClass("border-bottom-none");
            $(".sub-filter div ul li").off("click").on("click", function (event) {
                pageCount = 0;
                event.stopPropagation();
                $(".sub-filter div li").removeClass("active");
                $(this).addClass("active");
                var pCode = $(this).attr("code");
                var params = {
                    CATEGORY_PARENT_CODE: pCode
                };
                getFundType(params, ".sub-filter", 3);
            });
        } else {
            if ($(".sub-filter").length > 0) {
                $(".sub-filter").remove();
            }
            $(".fdlist-filter").removeClass("pd-bottom-55");
            $(".fdlist-filter").removeClass("pd-bottom-115");
        }
    } else if (type == 3) { //第三级
        if (category.length > 0) { //货币ETF没有子级
            var html = "<div class='three-filter'><ul>";
            for (var i = 0; i < category.length; i++) {
                //if(category[i].CATEGORY_CODE!="F151"&&category[i].CATEGORY_CODE!="F152"){//三级栏目-不展示
                html += "<li code='" + category[i].CATEGORY_CODE + "'";
                html += ">" + category[i].CATEGORY_NAME + "</li>";
                //}
            }
            html += "</ul></div>";
            if ($(".three-filter").length > 0) {
                $(".three-filter").remove();
            }
            $(".fdlist-filter").removeClass("pd-bottom-55");
            $(".fdlist-filter").addClass("pd-bottom-115");
            $(id).append(html);
            $(".three-filter ul li").off("click").on("click", function (event) {
                pageCount = 0;
                event.stopPropagation();
                $(".three-filter li").removeClass("active");
                $(this).addClass("active");
            });
        } else {
            if ($(".three-filter").length > 0) {
                $(".three-filter").remove();
            }
            if ($(".sub-filter").length <= 0) {
                $(".fdlist-filter").removeClass("pd-bottom-115");
                $(".fdlist-filter").removeClass("pd-bottom-55");
            } else {
                $(".fdlist-filter").removeClass("pd-bottom-115");
                $(".fdlist-filter").addClass("pd-bottom-55");
            }
        }
    }
}
// 分页逻辑
function bindTurnPage(parentId, pageCount) {
    var pageObj = $(parentId + " .page");
    pageObj.off("click").on("click", function () {
        pageNo = parseInt($(this).html());
        beginPage = pageNo;
        hidePage(pageObj, pageCount, pageNo);
        changePageStyle(parentId, pageCount);
        pageObj.removeClass("active");
        $(this).addClass("active");
        if (parentId === "#fundlist-pag-mob") {
            getMobListData(false, false)
        } else {
            getListData(false, false);
        }

    });
    $(parentId + " .pagination-pre").off("click").on("click", function () {
        if (pageNo > 1) {
            pageNo = pageNo - 1;
            hidePage(pageObj, pageCount, pageNo);
            beginPage = pageNo;
            changePageStyle(parentId, pageCount);
            pageObj.removeClass("active");
            pageObj.eq(pageNo - 1).addClass("active");
            if (parentId === "#fundlist-pag-mob") {
                getMobListData(false, false)
            } else {
                getListData(false, false);
            }
        }
    });
    $(parentId + " .pagination-next").off("click").on("click", function () {
        if (pageNo < pageCount) {
            pageNo = pageNo + 1;
            hidePage(pageObj, pageCount, pageNo);
            beginPage = pageNo;
            changePageStyle(parentId, pageCount);
            pageObj.removeClass("active");
            pageObj.eq(pageNo - 1).addClass("active");
            if (parentId === "#fundlist-pag-mob") {
                getMobListData(false, false)
            } else {
                getListData(false, false);
            }
        }
    });
}

//隐藏分页项
function hidePage(pageObj, pageCount, pageNo) {
    for (j = 1; j < pageCount - 1; j++) {
        pageObj.eq(j).attr("style", "display:none")
    }
    pageObj.eq(pageNo - 2).attr("style", "display:block")
    pageObj.eq(pageNo - 1).attr("style", "display:block")
    pageObj.eq(pageNo).attr("style", "display:block")
    if (pageNo - 2 > 1) {
        $("#prePlaceHolder").show()
        $("#prePlaceHolder-mob").show()
    } else {
        $("#prePlaceHolder").hide()
        $("#prePlaceHolder-mob").hide()
    }
    if (pageNo < pageCount - 2) {
        $("#nextPlaceHolder").show()
        $("#nextPlaceHolder-mob").show()
    } else {
        $("#nextPlaceHolder").hide()
        $("#nextPlaceHolder-mob").hide()
    }
}

//点击左右翻页箭头时动态改变箭头样式
function changePageStyle(parentId, pgcount) {
    if (pageNo > 1) {
        $(parentId + " .pagination-pre").removeClass("blur");
    } else {
        $(parentId + " .pagination-pre").addClass("blur");
    }
    if (pageNo >= pgcount) {
        $(parentId + " .pagination-next").addClass("blur");
    } else {
        $(parentId + " .pagination-next").removeClass("blur");
    }
}

//搜索基金代码简称
function getSearchContent(obj) {
    var kw = obj.value.trim()
    if (kw == '') {
        searchAppend.style.display = 'none'
        searchAppend.innerHTML = ''
        return false
    }
    var html = ''
    var index = 0;
    for (var i = 0; i < searchListData.length; i++) {
        if (index > 9) {
            break;
        }
        if (searchListData[i].search(kw) >= 0) {
            html =
                html +
                "<div class='searchItem' onClick='getSearchCon(this);'>" +
                searchListData[i] +
                '</div>';
            index++;
        }
    }
    searchAppend.style.display = 'block'
    searchAppend.innerHTML = html
    if (html == "") {
        searchAppend.style.display = 'none';
    }
}

function getSearchCon(obj, id) {
    var value = obj.innerText
    var index = value.indexOf("(");
    value = value.substring(0, index);
    $("#FUND_CODE").val(value)
    searchAppend.style.display = 'none'
    searchAppend.innerHTML = ''
}


//移动端搜索基金代码简称
function getMobSearchContent(obj) {
    var kw = obj.value.trim();
    if (kw == '') {
        mobSearchAppend.style.display = 'none'
        mobSearchAppend.innerHTML = '';
        return false
    }
    var html = ''
    for (var i = 0; i < searchListData.length; i++) {
        if (searchListData[i].search(kw) >= 0) {
            html =
                html +
                "<div class='searchItem' onClick='getMobSearchCon(this);'>" +
                searchListData[i] +
                '</div>';
        }
    }
    mobSearchAppend.style.display = 'block';
    mobSearchAppend.innerHTML = html;
    if (html == '') {
        mobSearchAppend.style.display = 'none';
    }
}

function getMobSearchCon(obj, id) {
    var value = obj.innerText;
    var index = value.indexOf("(");
    value = value.substring(0, index);
    $("#MOB_FUND_CODE").val(value)
    mobSearchAppend.style.display = 'none';
    mobSearchAppend.innerHTML = ''
}

// ============ 基金列表 -搜索框部分 ==================
var params = {
    "CATEGORY": "F000",
    "type": "inParams"
};
var searchCompany = $('#searchAppendCompany')
var searchIndex = $('#searchAppendIndex')
var mob_searchCompany = $('#mob_searchAppendCompany')
var mob_searchIndex = $('#mob_searchmb_AppendIndex')
var companyName = []
var indexName = []

// 数组排序去重
function unique(arr, prop) {
    if (!Array.isArray(arr)) {
        console.log('type error!')
        return;
    }
    arr = arr.sort(function (a, b) {
        return a.localeCompare(b, 'zh')
    })
    var arrry = [arr[0]];
    for (var i = 1; i < arr.length; i++) {
        if (arr[i] !== arr[i - 1]) {
            arrry.push(arr[i]);
        }
    }
    return arrry;
}
// 点击提示赋值input
function getValue(obj, id) {
    var value = obj.innerText
    var elm = $(obj).parent().prev().prev()
    var equipment = elm.attr('attr').split(' ')[0]
    var type = elm.attr('attr').split(' ')[1]
    elm.val(value)
    fundKeyup(elm, equipment, type)
    if (equipment == 'pc') {
        if (type == 'company') {
            hideElm = searchCompany;
        } else {
            hideElm = searchIndex;
        }
    } else {
        if (type == 'company') {
            hideElm = mob_searchCompany;
        } else {
            hideElm = mob_searchIndex;
        }
    }
    hideElm.hide()
}
// 搜索框模糊查询
function fundKeyup(obj, equipment, type) {
    var kw = $(obj).val().trim();
    var elm, arrayData;
    if (equipment == 'pc') {
        if (type == 'company') {
            arrayData = companyName
            elm = searchCompany;
        } else {
            arrayData = indexName
            elm = searchIndex;
        }
    } else {
        if (type == 'company') {
            arrayData = companyName
            elm = mob_searchCompany;
        } else {
            arrayData = indexName
            elm = mob_searchIndex;
        }
    }
    if (kw == '') {
        getElmData(arrayData, elm)
        elm.hide();
        return false;
    }
    getElmData(arrayData, elm, kw, true)
    elm.show()
    if (elm.html() == "") {
        elm.hide()
    }
}
// 提示框内容
function getElmData(arrayData, elm, kw, search) {
    if (search) {
        var html = ''
        if(arrayData.length > 0 && arrayData[0] != undefined){
            for (var i = 0; i < arrayData.length; i++) {
                if (arrayData[i].search(kw) >= 0) {
                    html += '<div style="text-overflow: ellipsis;white-space: nowrap;overflow: hidden;" class="searchItem"  onclick="getValue(this);">' + arrayData[i] + '</div>'
                }
            }
        }
        elm.html(html)
        return
    }
    var htmlContent = '';
    if(arrayData.length > 0 && arrayData[0] != undefined){
        for (var i = 0; i < arrayData.length; i++) {
            htmlContent += '<div style="text-overflow: ellipsis;white-space: nowrap;overflow: hidden;" class="searchItem"  onclick="getValue(this);">' + arrayData[i] + '</div>'
        }
    }
    elm.html(htmlContent)
}
// 下拉按钮点击事件
function companyClick(equipment, type) {
    window.event.stopPropagation();
    var elmHide, elm;
    if (equipment == 'pc') {
        if (type == 'company') {
            elmHide = searchIndex
            elm = searchCompany
        } else {
            elmHide = searchCompany
            elm = searchIndex
        }
    } else {
        if (type == 'company') {
            elmHide = mob_searchIndex
            elm = mob_searchCompany
        } else {
            elmHide = mob_searchCompany
            elm = mob_searchIndex
        }
    }

    var companyMob = $('#MOB_COMPANY_NAME').val();
    var indexMob = $('#MOB_INDEX_NAME').val();
    if (companyMob == '') {
        getElmData(companyName, mob_searchCompany)
    }
    if (indexMob == '') {
        getElmData(indexName, mob_searchIndex)
    }
    elmHide.hide();
    if (elm.prop("style").display === "block" || elm.html() == "") return elm.hide();
    elm.show();
}

// 基金管理人与指数提示框内容初始化
ajaxJsonp($api.getFundListNoPagination, "GET", params, function (res) {
    var result = res.result;
    // 基金管理人与指数数据
    for (var i = 0; i < result.length; i++) {
        if (result[i].COMPANY_NAME != "-" && result[i].COMPANY_NAME != null) companyName.push(result[i].COMPANY_NAME.trim());
        if (result[i].INDEX_NAME != "-" && result[i].INDEX_NAME != null) indexName.push(result[i].INDEX_NAME.trim());
    }
    
    companyName = unique(companyName)
    indexName = unique(indexName)
    // pc 端  
    getElmData(companyName, searchCompany)
    getElmData(indexName, searchIndex)
    // 手机端
    getElmData(companyName, mob_searchCompany)
    getElmData(indexName, mob_searchIndex)
}, function (err) {
    console.log(err)
});